# Bochs Configuration for UEFI/OVMF Testing
# Testing Phase 1: Baseline OVMF loading

# Memory: 256MB (OVMF requires minimum 64MB)
memory: guest=256, host=256

# ROM image: OVMF Code (3.5MB, needs 4MB ROM space)
# Load at 0xFFC00000 (4GB - 4MB) for 4MB ROM
romimage: file=bochs/bios/OVMF_CODE.fd, address=0xffc00000

# VGA BIOS (Cirrus)
vgaromimage: file=bochs/bios/VGABIOS-lgpl-latest-cirrus.bin

# CPU configuration
cpu: count=1, ips=50000000, reset_on_triple_fault=1, model=corei7_sandy_bridge_2600k

# PCI chipset (i440FX - supported by OVMF)
pci: enabled=1, chipset=i440fx

# Cirrus VGA (PCI mode - required by OVMF)
display_library: nogui
vga: extension=cirrus

# Serial port for OVMF debug output
com1: enabled=1, mode=file, dev=ovmf-debug.log

# ATA controllers (both channels enabled per Issue #471)
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata1: enabled=1, ioaddr1=0x170, ioaddr2=0x370, irq=15

# Boot from hard disk (we'll create a simple test disk later)
# For now, just boot to UEFI shell
boot: disk

# Disable features not needed for initial test
mouse: enabled=0
keyboard: type=mf, serial_delay=250
